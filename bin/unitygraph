#!/bin/sh
# Plugin entry point: Claude Code puts this bin/ directory on the Bash PATH.
# Runs the bundled script with the first real Python it finds (skipping the Windows Store stub).
core="$(cd "$(dirname "$0")/../src/unitygraph" && pwd)/core.py"
for py in python3 python py; do
  path="$(command -v "$py" 2>/dev/null)" || continue
  case "$path" in *WindowsApps*) continue ;; esac
  exec "$py" "$core" "$@" </dev/null
done
echo "unitygraph: Python 3.9+ not found on PATH" >&2
exit 1
